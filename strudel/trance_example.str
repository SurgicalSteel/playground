setCpm(140/4)

$: s("korgt3_bd:2!4").beat("0,4,8,11,14",16)._scope()
$: n("<3@3 4 5 @3 6>*2".add("-14, -21")).scale("g:minor")
   .s("supersaw").o(2).seg(16).rlp(0.455).lpenv(2)

$: s("dmx_cp:2!4").o(5).beat("0,4,8,11,14",16)

$: n("0@2 <-7 [-5 -2]>@3 <0 -3 2 1>@3").add(7).add("<5 4 0 <0 2>>")
   .scale("g:minor").s("supersaw").o(3).delay(.7).pan(rand)
   .rlp(0.455).fm(.5).fmwave("brown").lpenv("<4 2 1 0 -1 -2 -4>/4")._pianoroll()

$: s("pulse!16").dec(.1).fm(time).fmh(time).o(4)

$: s("gm_kalimba:6").note("g2 bb3 d3".add("<0 0 7 12 0>*8"))
   .scrub(rand.seg(16).rib(46,2))
   .pan(rand)
   .delay(.9)
   .o(10)
   .fm(.5).distort("<0 2 3 2 0>")
